// skyline: run porTraits inside ONE SLURM job per batch of MAGs (local executor),
// with pre-pulled Singularity images (compute nodes have no internet).
params {
    skip_gtdbtk      = true
    gtdbtk_data      = "NA"
    query_metatraits = "none"
    emapper_annotations = System.getenv('PORTRAITS_EMAPPER_DIR') ?: null
}

executor {
    name   = 'local'
    cpus   = System.getenv('PORTRAITS_CPUS') as int
    memory = System.getenv('PORTRAITS_MEM')
}

process {
    resourceLimits = [ cpus: System.getenv('PORTRAITS_CPUS') as int,
                       memory: System.getenv('PORTRAITS_MEM') ]
    // a failing genome is retried once, then skipped (listed in <batch>/skipped_tasks.txt)
    errorStrategy  = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries     = 1
    container      = System.getenv('PORTRAITS_SIF_PORTRAITS')
    withName: recognise_genome { container = System.getenv('PORTRAITS_SIF_RECOGNISE') }
    withName: eggnog_mapper    { container = System.getenv('PORTRAITS_SIF_EGGNOG')
                                 cpus = System.getenv('PORTRAITS_EGGNOG_CPUS') as int
                                 memory = System.getenv('PORTRAITS_EGGNOG_MEM') }
    withName: genomespot       { container = System.getenv('PORTRAITS_SIF_PORTRAITS') }
    withName: emapper2matrix   { container = System.getenv('PORTRAITS_SIF_PORTRAITS') }
    withName: micropherret     { container = System.getenv('PORTRAITS_SIF_PORTRAITS') }
    withName: bacdive_ai       { container = System.getenv('PORTRAITS_SIF_PORTRAITS') }
    withName: traitar          { container = System.getenv('PORTRAITS_SIF_PORTRAITS') }
    withName: collate_results  { container = System.getenv('PORTRAITS_SIF_PORTRAITS') }
}

docker      { enabled = false }
singularity {
    enabled    = true
    autoMounts = true
}
